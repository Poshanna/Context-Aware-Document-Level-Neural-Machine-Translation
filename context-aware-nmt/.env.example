# =====================================================================
# Context-Aware Document-Level NMT - Environment Variables Template
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` to version control.
# =====================================================================

# ----------------------------
# General
# ----------------------------
PROJECT_NAME=context-aware-nmt
ENVIRONMENT=development               # development | staging | production
DEBUG=true

# ----------------------------
# Backend / FastAPI
# ----------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ----------------------------
# Authentication & Secrets
# ----------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_me_with_a_strong_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# Password hashing (argon2 preferred; fallback bcrypt)
PASSWORD_HASH_SCHEME=argon2

# ----------------------------
# PostgreSQL
# ----------------------------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=context_aware_nmt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me_with_a_db_password
# Constructed for convenience; do not include credentials in committed code
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ----------------------------
# File Uploads
# ----------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["txt","pdf","docx"]

# ----------------------------
# Hugging Face / Model Runtime
# ----------------------------
HF_HOME=/app/.cache/hf
TRANSFORMERS_OFFLINE=0              # set 1 only after you've pre-downloaded
FORCE_DEVICE=auto                   # auto | cpu | cuda
DEMO_MODE=1                         # 1 = banner if no GPU + allow CPU fallback

# ----------------------------
# Translation models (default checkpoints - names only, NOT auto-downloaded)
# ----------------------------
MODEL_INDICTRANS2_EN_TE=ai4bharat/indictrans2-en-te-1B
MODEL_INDICTRANS2_TE_EN=ai4bharat/indictrans2-te-en-1B
MODEL_NLLB200=facebook/nllb-200-distilled-600M
MODEL_DEFAULT=nllb200              # indictrans2 | nllb200
MODEL_NLLB200_LOCAL_PATH=
TRANSLATION_SOURCE_LANGUAGE=en
TRANSLATION_TARGET_LANGUAGE=te
TRANSLATION_MAX_INPUT_LENGTH=512
TRANSLATION_MAX_OUTPUT_LENGTH=256
TRANSLATION_SEED=42

# ----------------------------
# Context retrieval
# ----------------------------
CONTEXT_STRATEGY=sbert              # sbert | lastn
CONTEXT_K=3
CONTEXT_WINDOW=20
CONTEXT_MIN_SCORE=0.2
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ----------------------------
# Evaluation
# ----------------------------
ENABLE_COMET=0                      # 0 = disabled (GPU-heavy), 1 = enabled
COMET_MODEL=Unbabel/wmt22-comet-da
BERT_SCORE_MODEL=bert-base-multilingual-cased
EVAL_SEED=42
EVAL_ALLOW_LOCAL_PATHS=0            # 0 = upload only (safer), 1 = allow src_path/ref_path

# ----------------------------
# Dataset / Samanantar
# ----------------------------
# Path to the *extracted* Samanantar en-te folder on YOUR local machine.
# Scripts NEVER auto-download this. Placeholder relative path only — change it
# to wherever you extract the tarball (absolute Windows/Linux paths both OK).
SAMANANTAR_DATA_PATH=./data/raw/samanantar
DATASET_SEED=42                     # seed used for train/val/test splitting (80/10/10)
